[TEMPLATE]
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project reference — used by the migration scripts (supa:link).
PROJECT_REF=<project-ref>

# Supabase project URL and keys (Dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<service-role-key>

# Public site URL (used for auth redirects / canonical URLs).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional app keys
CRON_SECRET=<vercel-cron-secret>
GROQ_API_KEY=<groq-api-key>
JSEARCH_API_KEY=<jsearch-api-key>

# Seed script (scripts/createUser.cjs) — optional overrides for the demo admin user.
# Email/password/name can also be passed as CLI args: node scripts/createUser.cjs <email> <password> <name>
# SEED_ADMIN_EMAIL=fareed.zafar@recursolabs.com
# SEED_ADMIN_PASSWORD=<password>
# SEED_ADMIN_NAME=Fareed Zafar
